--// Bullets UI + TP/Bed Loop + Camera Fix

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local TARGET_POSITION = Vector3.new(
	-1686.31201171875,
	-3,
	-2534.194091796875
)

local POSITION_TOLERANCE = 10

--==================================================
-- UI
--==================================================

local gui = Instance.new("ScreenGui")
gui.Name = "BulletsBypass"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 250, 0, 130)
main.Position = UDim2.new(0.5, -125, 0.5, -65)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundTransparency = 1
title.Text = "Bullets Bypass"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = main

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(1, -30, 0, 50)
toggle.Position = UDim2.new(0, 15, 0, 60)
toggle.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.TextSize = 14
toggle.Font = Enum.Font.GothamMedium
toggle.Parent = main

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 9)
toggleCorner.Parent = toggle

--==================================================
-- ENABLE / DISABLE
--==================================================

local enabled = false

local function updateButton()
	toggle.Text = "TP / Bed Loop: " .. (enabled and "ON" or "OFF")
end

updateButton()

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled
	updateButton()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.E then
		enabled = not enabled
		updateButton()
	end
end)

--==================================================
-- HASSPAWNED
--==================================================

local function getHasSpawned()

	local attributeValue = player:GetAttribute("hasSpawned")

	if attributeValue ~= nil then
		return attributeValue
	end

	local value = player:FindFirstChild("hasSpawned")

	if value and value:IsA("BoolValue") then
		return value.Value
	end

	return nil
end

--==================================================
-- POSITION
--==================================================

local function isNearTarget()

	local character = player.Character

	if not character then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	return (root.Position - TARGET_POSITION).Magnitude <= POSITION_TOLERANCE
end

--==================================================
-- CAMERA
--==================================================

local function updateCamera()

	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera

	if humanoid and camera then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	end
end

--==================================================
-- GUI + CAMERA
-- CHECK EVERY 0.2 SECONDS
--
-- IMPORTANT:
-- SI JE NE SUIS PAS AU -1686...
-- => GUI ON + CAMERA
--==================================================

task.spawn(function()

	while task.wait(0.2) do

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		if root then

			local distance =
				(root.Position - TARGET_POSITION).Magnitude

			local NOT_AT_SPAWN = distance > POSITION_TOLERANCE

			local playerGui = player:FindFirstChild("PlayerGui")

			if playerGui then

				local mainGui = playerGui:FindFirstChild("MainGui")
				local topbar = playerGui:FindFirstChild("Topbar")
				local spawnGui = playerGui:FindFirstChild("SpawnGui")

				if NOT_AT_SPAWN then

					--========================================
					-- PAS AU -1686...
					-- GUI + CAMERA ON
					--========================================

					if mainGui then
						mainGui.Enabled = true
					end

					if topbar then
						topbar.Enabled = true
					end

					if spawnGui then
						spawnGui.Enabled = false
					end

					updateCamera()

				else

					--========================================
					-- AU -1686...
					-- GUI OFF
					--========================================

					if mainGui then
						mainGui.Enabled = false
					end

					if topbar then
						topbar.Enabled = false
					end

					if spawnGui then
						spawnGui.Enabled = true
					end

				end
			end
		end
	end
end)

--==================================================
-- BED LOOP
--==================================================

task.spawn(function()

	while task.wait(1) do

		if enabled then

			local nearSpawn = isNearTarget()
			local hasSpawned = getHasSpawned()

			if nearSpawn and hasSpawned == false then

				pcall(function()
					ReplicatedStorage.Events.SpawnFirst:InvokeServer(true)
				end)

			end
		end
	end
end)

--==================================================
-- CHARACTER ADDED
--==================================================

player.CharacterAdded:Connect(function(character)

	character:WaitForChild("Humanoid")
	character:WaitForChild("HumanoidRootPart")

end)
