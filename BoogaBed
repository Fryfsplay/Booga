local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 9)
toggleCorner.Parent = toggle

--==================================================
-- CHARACTER / ROOT
--==================================================

local function getRoot()
	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- HASSPAWNED
--==================================================

local function getHasSpawned()

	-- Attribute
	local attributeValue = player:GetAttribute("hasSpawned")

	if attributeValue ~= nil then
		return attributeValue
	end

	-- BoolValue
	local value = player:FindFirstChild("hasSpawned")

	if value and value:IsA("BoolValue") then
		return value.Value
	end

	return nil
end

local function hasSpawnedIsFalse()
	return getHasSpawned() == false
end

local function hasPlayerSpawned()
	return getHasSpawned() == true
end

--==================================================
-- POSITION CHECK
--==================================================

local function isNearTarget()
	local root = getRoot()

	if not root then
		return false
	end

	return (root.Position - TARGET_POSITION).Magnitude <= POSITION_TOLERANCE
end

--==================================================
-- CAMERA FIX
-- ONLY AFTER hasSpawned == true
--==================================================

local function updateCamera()

	if not hasPlayerSpawned() then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera

	if humanoid and camera then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	end
end

-- Camera loop
task.spawn(function()

	while task.wait(0.5) do

		if hasPlayerSpawned() then
			updateCamera()
		end

	end
end)

--==================================================
-- STATUS
--==================================================

local function updateStatus()

	if not enabled then
		status.Text = "Disabled"
		status.TextColor3 = Color3.fromRGB(170, 170, 180)
		return
	end

	if not isNearTarget() then
		status.Text = "Out of position"
		status.TextColor3 = Color3.fromRGB(255, 180, 80)
		return
	end

	if not hasSpawnedIsFalse() then
		status.Text = "hasSpawned is not false"
		status.TextColor3 = Color3.fromRGB(255, 180, 80)
		return
	end

	status.Text = "Conditions OK"
	status.TextColor3 = Color3.fromRGB(100, 255, 130)
end

--==================================================
-- ENABLE / DISABLE
--==================================================

local function setEnabled(state)

	enabled = state

	if enabled then
		toggle.Text = "Bed Loop: ON"
		toggle.BackgroundColor3 = Color3.fromRGB(45, 120, 70)
	else
		toggle.Text = "Bed Loop: OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(120, 45, 45)
	end

	updateStatus()
end

--==================================================
-- BUTTON
--==================================================

toggle.MouseButton1Click:Connect(function()
	setEnabled(not enabled)
end)

--==================================================
-- E KEY
--==================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)

	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.E then
		setEnabled(not enabled)
	end

end)

--==================================================
-- BED LOOP
--==================================================

task.spawn(function()

	while true do

		task.wait(LOOP_INTERVAL)

		if enabled then

			updateStatus()

			if isNearTarget() and hasSpawnedIsFalse() then

				pcall(function()
					ReplicatedStorage.Events.SpawnFirst:InvokeServer(true)
				end)

			end
		end
	end
end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function(character)

	-- Wait for new character
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)

	if not humanoid or not root then
		return
	end

	-- Give the game time to load its GUIs
	task.wait(0.5)

	local playerGui = game:GetService("Players").LocalPlayer.PlayerGui

	--==================================================
	-- GUI STATES
	--==================================================

	local mainGui = playerGui:WaitForChild("MainGui", 10)

	if mainGui then
		mainGui.Enabled = true
	end

	local topbar = playerGui:WaitForChild("Topbar", 10)

	if topbar then
		topbar.Enabled = true
	end

	local spawnGui = playerGui:WaitForChild("SpawnGui", 10)

	if spawnGui then
		spawnGui.Enabled = false
	end

	--==================================================
	-- CAMERA
	--==================================================

	task.wait(0.2)

	if hasPlayerSpawned() then
		updateCamera()
	end

	--==================================================
	-- STATUS
	--==================================================

	if enabled then
		updateStatus()
	end

end)

--==================================================
-- INITIALIZATION
--==================================================

setEnabled(false)
