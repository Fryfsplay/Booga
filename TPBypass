task.spawn(function()
    local KILL_IMG = true

    local function getNotif()
        local pg = P:FindFirstChild("PlayerGui"); if not pg then return end
        local mg = pg:FindFirstChild("MainGui"); if not mg then return end
        local sb = mg:FindFirstChild("Subordinates"); if not sb then return end
        return sb:FindFirstChild("Notifications")
    end

    local function hide(o)
        if not o or not o.Parent then return end
        if o:IsA("GuiObject") then
            pcall(function()
                o.Visible = false
                o.Size = UDim2.new()
                o.BackgroundTransparency = 1
            end)
        end
        if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
            pcall(function()
                o.TextTransparency = 1
                o.TextStrokeTransparency = 1
                o.BackgroundTransparency = 1
            end)
        end
        if KILL_IMG and (o:IsA("ImageLabel") or o:IsA("ImageButton")) then
            pcall(function()
                o.ImageTransparency = 1
                o.BackgroundTransparency = 1
            end)
        end
    end

    local function proc(o)
        hide(o)
        for _, d in ipairs(o:GetDescendants()) do hide(d) end
    end

    local N = getNotif()
    while not N do
        if isDead() then return end
        task.wait(0.5)
        N = getNotif()
    end
    print("[NotifHide] Connecté à:", N:GetFullName())

    for _, d in ipairs(N:GetDescendants()) do proc(d) end
    hide(N)

    N.DescendantAdded:Connect(function(o)
        task.defer(function() proc(o) end)
    end)
    N.ChildAdded:Connect(function(o)
        task.defer(function() proc(o) end)
    end)

    local acc = 0
    RunService.Heartbeat:Connect(function(dt)
        if isDead() then return end
        acc = acc + dt
        if acc < 0.1 then return end
        acc = 0
        local n = getNotif()
        if not n then return end
        for _, c in ipairs(n:GetChildren()) do
            if c:IsA("GuiObject") and c.Visible then proc(c) end
        end
    end)
end)

